  "TLS_KEY_PATH": { "class": ["tls", "path", "secret", "optional"] },
  "COOKIE_SECURE": { "class": ["security", "defaulted"], "default": "true" },
  "DB_PATH": { "class": ["storage", "path", "defaulted"], "default": "./data/console.db" },
  "DB_BACKUP_DIR": { "class": ["storage", "path", "optional"] },
  "SERVICES_FILE": { "class": ["configuration", "path", "defaulted"], "default": "./services.json" },
  "PUBLIC_DIR": { "class": ["static", "path", "defaulted"], "default": "./public" },
