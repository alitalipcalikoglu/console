  "NOTIFY_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "AUTH_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "MEDIA_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "GATEWAY_METRICS_TOKEN": { "class": ["downstream", "secret", "configuration-dependent"] },
  "AUDIT_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "SHORTLINK_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "FLAGS_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "SCHEDULER_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "WEBHOOK_OUT_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "SEARCH_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "RATELIMIT_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] },
  "GEO_API_KEY": { "class": ["downstream", "secret", "configuration-dependent"] }
