{
  "PORT": { "class": ["network", "defaulted"], "default": "3004" },
  "HOST": { "class": ["network", "defaulted"], "default": "0.0.0.0" },
  "LOG_LEVEL": { "class": ["optional", "defaulted"], "default": "info" },
  "TRUST_PROXY": { "class": ["trust-proxy", "defaulted"], "default": "false" },
