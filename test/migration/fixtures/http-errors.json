{
  "unauthenticated": {
    "status": 401,
    "body": { "error": { "code": "UNAUTHENTICATED", "message": "sign in required" } }
  },
  "viewerMutation": {
    "status": 403,
    "body": { "error": { "code": "FORBIDDEN", "message": "viewers cannot change anything" } }
  },
  "missingCsrf": {
    "status": 403,
    "body": { "error": { "code": "FORBIDDEN", "message": "missing x-console-request header" } }
  },
  "invalidLogin": {
    "status": 401,
    "body": { "error": { "code": "INVALID_CREDENTIALS", "message": "email or password is incorrect" } }
  },
  "missingRequired": {
    "status": 400,
    "body": {
      "error": {
        "code": "VALIDATION_FAILED",
        "message": "body must have required property 'email'",
        "details": [{ "path": "", "message": "must have required property 'email'" }]
      }
    }
  },
  "malformedJson": {
    "status": 400,
    "body": {
      "error": {
        "code": "FST_ERR_CTP_INVALID_JSON_BODY",
        "message": "Body is not valid JSON but content-type is set to 'application/json'"
      }
    }
  },
  "oversizedJson": {
    "status": 413,
    "body": { "error": { "code": "FST_ERR_CTP_BODY_TOO_LARGE", "message": "Request body is too large" } }
  }
}
