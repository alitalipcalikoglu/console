{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "build/**/*.js"],
  "exclude": ["node_modules"]
}
