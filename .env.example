# --- Server ---
PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Session cookie gets the Secure flag. Set false ONLY for plain-http local development.
COOKIE_SECURE=true

# --- Storage ---
DB_PATH=./data/console.db
SERVICES_FILE=./services.json
PUBLIC_DIR=./public
AUDIT_RETENTION_DAYS=365

# --- Sessions & sign-in ---
CONSOLE_SESSION_TTL_MIN=720
CONSOLE_SESSION_IDLE_MIN=60
CONSOLE_LOGIN_MAX_FAILURES=5
CONSOLE_LOGIN_LOCKOUT_MIN=15
# scrypt cost as log2(N); 15 ≈ 100 ms per check.
SCRYPT_LOG_N=15
# Shown in authenticator apps next to the account.
TOTP_ISSUER=atc console
# Login/TOTP attempts per IP per minute.
RATE_LIMIT_MAX=30
# Timeout for calls to the services.
SERVICE_TIMEOUT_MS=10000

# --- Service credentials referenced by services.json ("apiKeyEnv" / "metricsTokenEnv").
# Each is the secret of a dedicated "console" entry in that service's key list.
NOTIFY_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_NOTIFY_API_KEYS
AUTH_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_AUTH_API_KEYS
MEDIA_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_MEDIA_API_KEYS
GATEWAY_METRICS_TOKEN=REPLACE_WITH_THE_GATEWAY_METRICS_TOKEN
# A read-role key from the audit service (AUDIT_API_KEYS=console:…:read).
AUDIT_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_AUDIT_API_KEYS
# A readwrite key from the shortlink service (the console creates and edits links).
SHORTLINK_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_SHORTLINK_API_KEYS
