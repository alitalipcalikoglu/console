# --- Server ---
PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Session cookie gets the Secure flag. Set false ONLY for plain-http local development.
COOKIE_SECURE=true

# --- Storage ---
DB_PATH=./data/console.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
SERVICES_FILE=./services.json
PUBLIC_DIR=./public
AUDIT_RETENTION_DAYS=365

# --- Sessions & sign-in ---
CONSOLE_SESSION_TTL_MIN=720
CONSOLE_SESSION_IDLE_MIN=60
CONSOLE_LOGIN_MAX_FAILURES=5
CONSOLE_LOGIN_LOCKOUT_MIN=15
# scrypt cost as log2(N); 15 ≈ 100 ms per check.
SCRYPT_LOG_N=15
# Shown in authenticator apps next to the account.
TOTP_ISSUER=atc console
# Seals TOTP secrets at rest (AES-256-GCM). 64 hex chars. Generate: openssl rand -hex 32
# Required to enrol two-factor for the first time, or if any admin already has it enabled. Leave
# empty only for a fresh install where no admin has ever enabled TOTP.
SECRETS_KEY=
# During a SECRETS_KEY rotation only: the key being retired, so secrets still sealed under it keep
# decrypting while the service reseals them to the new SECRETS_KEY. Remove once reseal is confirmed
# done (see "Rotating SECRETS_KEY" in README.md) — never set on a normal, non-rotating start.
SECRETS_PREVIOUS_KEY=
# Login/TOTP attempts per IP per minute.
RATE_LIMIT_MAX=30
# Timeout for calls to the services.
SERVICE_TIMEOUT_MS=10000

# --- Service credentials referenced by services.json ("apiKeyEnv" / "metricsTokenEnv").
# Each is the secret of a dedicated "console" entry in that service's key list.
NOTIFY_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_NOTIFY_API_KEYS
AUTH_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_AUTH_API_KEYS
MEDIA_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_MEDIA_API_KEYS
GATEWAY_METRICS_TOKEN=REPLACE_WITH_THE_GATEWAY_METRICS_TOKEN
# A readwrite key from the audit service (AUDIT_API_KEYS=console:…:readwrite): the console reads events and forwards its own log as console.* events.
AUDIT_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_AUDIT_API_KEYS
# A readwrite key from the shortlink service (the console creates and edits links).
SHORTLINK_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_SHORTLINK_API_KEYS
# A readwrite key without environment scope from the flags service (the console manages every environment).
FLAGS_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_FLAGS_API_KEYS
# A readwrite key from the scheduler service (the console creates jobs, runs them now and cancels runs).
SCHEDULER_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_SCHEDULER_API_KEYS
# A readwrite key from the webhook-out service (the console manages subscriptions, tests, replays and redeliveries).
WEBHOOK_OUT_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_WEBHOOK_API_KEYS
# A readwrite key without index scope from the search service (the console manages every index).
SEARCH_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_SEARCH_API_KEYS
# A readwrite key without policy scope from the ratelimit service (the console manages every policy and override).
RATELIMIT_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_RATELIMIT_API_KEYS
# A readwrite key from the geo service (the console manages place collections and reloads the IP database).
GEO_API_KEY=REPLACE_WITH_THE_CONSOLE_KEY_FROM_GEO_API_KEYS
