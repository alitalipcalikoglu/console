{
  "name": "@atc-web/console",
  "version": "1.1.2",
  "private": true,
  "description": "Admin console for the atc-web services: one installable web app to watch and operate notify, auth, media, gateway, audit, shortlink and flags",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/console.git"
  },
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "smoke:build": "npm run build && node scripts/verify-sveltekit-build.mjs",
    "smoke:runtime": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-runtime.mjs",
    "smoke:auth": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-auth.mjs",
    "smoke:m4": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m4.mjs",
    "smoke:m5": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m5.mjs",
    "smoke:m6": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m6.mjs",
    "smoke:m7": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m7.mjs",
    "smoke:browser": "npm run build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m7-browser.mjs",
    "admin": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/admin.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json && npm run check"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#v1.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "swagger-ui-dist": "5.33.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.3",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
