{
  "name": "@atc-web/console",
  "version": "1.1.0",
  "private": true,
  "description": "Admin console for the atc-web services: one installable web app to watch and operate notify, auth, media, gateway, audit, shortlink and flags",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/console.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "dev:ui": "vite --config vite.legacy.config.js",
    "build": "vite build --config vite.legacy.config.js",
    "kit:dev": "vite dev",
    "kit:sync": "svelte-kit sync",
    "kit:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "kit:build": "vite build",
    "kit:preview": "vite preview",
    "kit:smoke": "npm run kit:build && node scripts/verify-sveltekit-build.mjs",
    "kit:runtime": "node --disable-warning=ExperimentalWarning server.mjs",
    "kit:runtime:smoke": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-runtime.mjs",
    "kit:auth:smoke": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-auth.mjs",
    "kit:m4:smoke": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m4.mjs",
    "kit:m5:smoke": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m5.mjs",
    "kit:m6:smoke": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m6.mjs",
    "kit:m7:smoke": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m7.mjs",
    "kit:m7:browser": "npm run kit:build && node --disable-warning=ExperimentalWarning scripts/verify-sveltekit-m7-browser.mjs",
    "admin": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json && svelte-check --workspace ui --tsconfig ./jsconfig.json && npm run kit:check"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#v1.12.0",
    "@fastify/static": "10.1.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.4",
    "swagger-ui-dist": "5.33.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.3",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
