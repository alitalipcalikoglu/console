{
  "name": "@atc-web/console",
  "version": "1.0.0",
  "private": true,
  "description": "Admin console for the atc-web services: one installable web app to watch and operate notify, auth, media, gateway, audit, shortlink and flags",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/console.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "dev:ui": "vite",
    "build": "vite build",
    "admin": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json && svelte-check --workspace ui --tsconfig ./jsconfig.json"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#v1.6.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.3",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
